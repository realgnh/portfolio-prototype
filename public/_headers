# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)

# Built JS/CSS/fonts have content hashes in their names, so browsers can cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Basic security headers for every page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
